# HTTP 7090 测试阶段保持为空和 false；接入网关域名后再填写并改为 true。
HTTP_PORT=7090
APP_ORIGIN=
COOKIE_SECURE=false

# 企业微信自建应用扫码登录。Secret 仅写入服务器环境文件，禁止进入前端或 Git。
WECOM_CORP_ID=
WECOM_AGENT_ID=
WECOM_CORP_SECRET=
WECOM_CALLBACK_URL=https://你的域名/api/auth/wecom/callback
# 单租户部署通常留空，系统会使用首个租户；多租户部署必须明确填写。
WECOM_TENANT_ID=

WORKER_CONCURRENCY=3
DB_POOL_SIZE=20
WORKER_DB_POOL_SIZE=10
RATE_LIMIT_PER_MINUTE=180
SESSION_HOURS=12
MAX_UPLOAD_MB=15
BACKUP_RETENTION_DAYS=14
