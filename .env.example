AMAP_WEB_SERVICE_KEY=
NEXT_PUBLIC_AMAP_JS_KEY=
NEXT_PUBLIC_AMAP_SECURITY_CODE=
NEXT_PUBLIC_API_URL=/api
DATABASE_URL=sqlite:///./data/store_poi.db
AMAP_API_BASE_URL=https://restapi.amap.com
AMAP_REQUEST_TIMEOUT=15
AMAP_MAX_CONCURRENCY=3
AMAP_REQUEST_INTERVAL_MS=400
ENABLE_MOCK_AMAP=true
MAX_IMPORT_ROWS=5000
DEEPSEEK_API_KEY=
DEEPSEEK_API_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash

# Enterprise accounts with 100 QPS may use 80 / 8 / 4 after verifying the console quota.
AMAP_MAX_QPS=10
BRAND_DISCOVERY_CONCURRENCY=1
POI_CATEGORY_CONCURRENCY=1
